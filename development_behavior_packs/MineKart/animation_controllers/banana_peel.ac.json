{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.banana_peel_find_player": {
            "initial_state": "default",
            "states": {
                "default": {
                    "animations": [
                        "find_player"
                    ],
                    "transitions": [
                        {
                            "detected": "query.is_sheared"
                        }
                    ]
                },
                "detected": {
                    "animations": [
                        "find_no_player"
                    ],
                    "transitions": [
                        {
                            "default": "!query.is_sheared"
                        }
                    ],
                    "on_entry": [
                        "/playanimation @e[family=kart,r=1.5,c=1] animation.mario_kart.spin",
                        "/effect @e[family=kart,r=1.5,c=1] slowness 2 6 true",
                        "/kill @s"
                    ]
                }
            }
        }
    }
}
